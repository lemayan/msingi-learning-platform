# ─── Web App (Next.js) ────────────────────────────────────────────────────────

# Sanity project
NEXT_PUBLIC_SANITY_PROJECT_ID=        # Sanity project ID (public)
NEXT_PUBLIC_SANITY_DATASET=           # Dataset name, e.g. "production" (public)
NEXT_PUBLIC_SANITY_API_VERSION=       # API date, e.g. "2026-09-09" (optional — defaults to env.ts value)
SANITY_API_READ_TOKEN=                # Read token for private dataset (SERVER ONLY — never expose to browser)
SANITY_API_WRITE_TOKEN=               # Write token for learner progress mutations (SERVER ONLY — falls back to READ_TOKEN if editor)

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=    # Clerk publishable key (public)
CLERK_SECRET_KEY=                     # Clerk secret key (SERVER ONLY)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# PostHog analytics
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=    # PostHog project API token (public)
NEXT_PUBLIC_POSTHOG_HOST=             # PostHog host (e.g. https://us.i.posthog.com) (public)

# AI Search (Sanity Context MCP / LLM)
GOOGLE_GENERATIVE_AI_API_KEY=         # Gemini API Key for intelligent search
OPEN_API_KEY=                         # OpenAI API Key (alternative provider)


# ─── Standalone Studio (`studio/`) ────────────────────────────────────────────

# Copy these into studio/.env.local
# SANITY_STUDIO_PROJECT_ID=           # Same project ID as above
# SANITY_STUDIO_DATASET=              # Same dataset as above
# SANITY_STUDIO_API_VERSION=          # Same API version as above
